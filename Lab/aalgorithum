A* Algorithm in Python
A* uses two values to find a path:

g
(
n
)
g(n): Cost from the start node to the current node.

h
(
n
)
h(n): Estimated cost from the current node to the goal.

Its evaluation function is:

f
(
n
)
=
g
(
n
)
+
h
(
n
)
f(n)=g(n)+h(n)
Python example
python
import heapq

def a_star(graph, start, goal, h):
    pq = [(h[start], 0, start)]
    parent = {}
    cost = {start: 0}

    while pq:
        _, g, node = heapq.heappop(pq)

        if node == goal:
            path = []
            while node in parent:
                path.append(node)
                node = parent[node]
            path.append(start)
            return path[::-1]

        if g != cost[node]:
            continue

        for neighbor, weight in graph[node]:
            new_cost = g + weight

            if new_cost < cost.get(neighbor, float('inf')):
                cost[neighbor] = new_cost
                parent[neighbor] = node
                heapq.heappush(
                    pq,
                    (new_cost + h[neighbor], new_cost, neighbor)
                )

    return None


graph = {
    'A': [('B', 1), ('C', 4)],
    'B': [('D', 2), ('E', 5)],
    'C': [('E', 1)],
    'D': [('E', 1)],
    'E': []
}

h = {'A': 4, 'B': 3, 'C': 1, 'D': 1, 'E': 0}

print(a_star(graph, 'A', 'E', h))
